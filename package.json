{
  "name": "wuwa_calc",
  "version": "1.0.0",
  "description": "Stat, buff and gear system. TypeScript compiled with tsc; esbuild only concatenates tsc's output into the two files the page loads (see dev.py). No runtime dependencies.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build": "tsc && npm run bundle",
    "watch": "tsc --watch",
    "dev": "python dev.py",
    "test": "echo \"Error: no test specified\" && exit 1",
    "precompute": "node dist/src/precompute.js",
    "bundle": "esbuild dist/src/index.js dist/src/solver.js --bundle --splitting --format=esm --outdir=dist/bundle --outbase=dist/src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Riley31415/wuwa_calc.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Riley31415/wuwa_calc/issues"
  },
  "homepage": "https://github.com/Riley31415/wuwa_calc#readme",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3"
  }
}
